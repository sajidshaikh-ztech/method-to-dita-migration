<attribute name="presentationName" nodeId="3df895fa">Conduct sprint review</attribute>
<attribute name="briefDescription" nodeId="77a000b0"></attribute>
<attribute name="suppressed" nodeId="f1442c82">false</attribute>
<attribute name="orderingGuide" nodeId="d734e75e"></attribute>

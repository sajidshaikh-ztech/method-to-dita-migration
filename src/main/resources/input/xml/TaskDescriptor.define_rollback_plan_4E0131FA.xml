<attribute name="presentationName" nodeId="7dc199a6">Define rollback plan</attribute>
<attribute name="briefDescription" nodeId="4919d6ed"></attribute>
<attribute name="suppressed" nodeId="b2fa1156">false</attribute>
<attribute name="orderingGuide" nodeId="f10b8ea4"></attribute>
<attribute name="authors" nodeId="a724383b"></attribute>

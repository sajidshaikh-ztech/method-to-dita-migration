<attribute name="mainDescription" nodeId="7f0d625d">&lt;p&gt;
    A security design may include the following:
&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;
        Design of authentication security model, authorization controls and security reporting
    &lt;/li&gt;
    &lt;li&gt;
        Guiding principles and authentication standards
    &lt;/li&gt;
    &lt;li&gt;
        Role design and definitions
    &lt;/li&gt;
    &lt;li&gt;
        Authentication security model, authorization controls and security reporting across multiple environments
    &lt;/li&gt;
    &lt;li&gt;
        Logical access paths
    &lt;/li&gt;
    &lt;li&gt;
        Authentication points
    &lt;/li&gt;
    &lt;li&gt;
        Entitlements
    &lt;/li&gt;
    &lt;li&gt;
        Controls
    &lt;/li&gt;
    &lt;li&gt;
        Global package settings and administrator rights
    &lt;/li&gt;
    &lt;li&gt;
        Authentication management process
    &lt;/li&gt;
    &lt;li&gt;
        User access rights, roles and responsibilities&lt;br /&gt;
    &lt;/li&gt;
&lt;/ul&gt;</attribute>
<attribute name="externalId" nodeId="e91ac852"></attribute>
<attribute name="keyConsiderations" nodeId="a488136d"></attribute>
<attribute name="longPresentationName" nodeId="439a6047"></attribute>
<attribute name="purpose" nodeId="f102b022">To define the security specifications needed by the technical team to develop functionality required by stakeholders.</attribute>
<attribute name="impactOfNotHaving" nodeId="171d51c9"></attribute>
<attribute name="reasonsForNotNeeding" nodeId="6ebe147d"></attribute>
<attribute name="briefOutline" nodeId="b3cb4bd8">&lt;ul&gt;
    &lt;li&gt;
        Authentication design 
    &lt;/li&gt;
    &lt;li&gt;
        Authorization design
    &lt;/li&gt;
    &lt;li&gt;
        Security reporting design&lt;br /&gt;
    &lt;/li&gt;
&lt;/ul&gt;</attribute>

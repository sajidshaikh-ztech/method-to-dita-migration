<attribute name="impactOfNotHaving" nodeId="6ff0376c"></attribute>
<attribute name="reasonsForNotNeeding" nodeId="4ac4457b"></attribute>
<attribute name="briefOutline" nodeId="749bd184">&lt;p&gt;
    The log should include the following information:
&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;
        Information being requested
    &lt;/li&gt;
    &lt;li&gt;
        Information provider
    &lt;/li&gt;
    &lt;li&gt;
        Information gathering technique (e.g., information request, interview, survey, workshop)
    &lt;/li&gt;
    &lt;li&gt;
        Person responsible for collecting the information
    &lt;/li&gt;
    &lt;li&gt;
        Date the information was requested
    &lt;/li&gt;
    &lt;li&gt;
        Date due
    &lt;/li&gt;
    &lt;li&gt;
        Status including date received
    &lt;/li&gt;
&lt;/ul&gt;</attribute>

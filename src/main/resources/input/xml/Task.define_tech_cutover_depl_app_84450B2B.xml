<attribute name="presentationName" nodeId="9c543853">Define technology cutover and deployment approach</attribute>
<attribute name="briefDescription" nodeId="14569cd1">Document a high-level process to prepare the organization for impending changes and manage the application, data and technology infrastructure aspects of the cutover and deployment.</attribute>
<attribute name="suppressed" nodeId="16c586f9">false</attribute>

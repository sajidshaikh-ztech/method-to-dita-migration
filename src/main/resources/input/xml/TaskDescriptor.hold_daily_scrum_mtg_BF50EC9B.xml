<attribute name="presentationName" nodeId="51e24c0e">Hold daily scrum meeting</attribute>
<attribute name="briefDescription" nodeId="34d41510"></attribute>
<attribute name="suppressed" nodeId="16a3a153">false</attribute>
<attribute name="orderingGuide" nodeId="f9289530"></attribute>
<attribute name="authors" nodeId="8c5e8f93"></attribute>

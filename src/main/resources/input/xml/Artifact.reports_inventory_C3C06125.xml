<attribute name="longPresentationName" nodeId="8340d9f8"></attribute>
<attribute name="purpose" nodeId="3e9062c9">&lt;p&gt;
    To list reports required by the organization to support efforts such as performing maintenance, identifying gaps or
    reducing redundancies.
&lt;/p&gt;</attribute>

<attribute name="name" nodeId="c0063704">Gather test metrics and other pertinent information</attribute>
<attribute name="guid" nodeId="972ebead">_Ga2N0AxXEeSmWrG3h62G2w</attribute>
<attribute name="presentationName" nodeId="4decb14">Gather test metrics and other pertinent information</attribute>

<attribute name="presentationName" nodeId="a0e2b29a">Prepare for the sprint review</attribute>
<attribute name="briefDescription" nodeId="9b9c2b01"></attribute>
<attribute name="suppressed" nodeId="1126caf4">false</attribute>
<attribute name="orderingGuide" nodeId="590dcb2a"></attribute>
<attribute name="authors" nodeId="ba5b6287"></attribute>
<attribute name="changeDate" nodeId="2b4f52cc">Fri Feb 14 10:44:58 EST 2025</attribute>

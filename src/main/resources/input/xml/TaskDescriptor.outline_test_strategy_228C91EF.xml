<Element Type="Section" TypeName="Section" NodeiconUrl="" DisplayName="Define test metrics and status reporting" Id="_hk3LcB2XEeSDYtcxfT4ZFw" ShapeiconUrl="images/guidance.gif" nodeId="c69ac9ae" Url="" Name="Define test metrics and status reporting" BackPath="">
